<?xml version="1.0"?>
<!-- Fork de vrx/vrx_urdf/wamv_gazebo/urdf/wamv_gazebo.urdf.xacro, voir
     CORRESPONDANCE_DOCKING.md. Copie complete plutot qu'un simple override,
     car ce fichier partage est aussi utilise par vrx_ardupilot (protege par
     le principe de non regression, voir PROPOSITION_SIMULATEUR_COMPLET.md
     paragraphe 8) : impossible d'y ajouter le correctif ci-dessous sans
     risquer d'affecter Mode B. Les macros incluses (xacro:wamv_gazebo etc.)
     restent partagees et non modifiees, seul ce fichier orchestrateur est
     copie.

     Correctif : element gazeboXYZToNED ajoute au bloc ArduPilotPlugin
     ci-dessous (seule difference avec l'original). ArduPilotPlugin.cc
     utilise par defaut Pose3d(0,0,0,GZ_PI,0,0), sans terme de lacet, quand
     cet element est absent ; son propre commentaire source
     (ArduPilotPlugin.cc, vers la ligne 1857) signale que la transform
     correcte devrait inclure un GZ_PI/2 de lacet, ce qui n'est pas le cas
     dans le xacro partage. Confirme empiriquement, pas seulement via le
     commentaire du plugin : en comparant simultanement la verite terrain
     Gazebo (/vrx_docking_sim/wamv/odometry) et
     /mavros/global_position/global, avant ce correctif la correspondance
     reelle etait Nord ArduPilot egal X Gazebo (Est), Est ArduPilot egal
     moins Y Gazebo (Nord), une rotation de 90 degres par rapport a la
     convention ENU vers NED attendue, avec l'orientation rapportee a
     MAVROS/Mission Planner decalee d'autant. Avec ce correctif, la
     conversion redevient Nord egal Y Gazebo, Est egal X Gazebo (la
     convention standard, deja utilisee par dock_pose_source_node.py et
     boat_pose_node.py), position et orientation. -->
<!-- Basic WAM-V with gazebo plugins for dynamics -->
<robot xmlns:xacro="http://ros.org/wiki/xacro"
       name="WAM-V">
  <xacro:arg name="locked" default="false" />
  <xacro:arg name="thruster_config" default="H" />
  <xacro:arg name="camera_enabled" default="false" />
  <xacro:arg name="gps_enabled" default="false" />
  <xacro:arg name="imu_enabled" default="false" />
  <xacro:arg name="lidar_enabled" default="false" />
  <xacro:arg name="ground_truth_enabled" default="false" />
  <xacro:arg name="vrx_sensors_enabled" default="false" />
  <xacro:arg name="pinger_enabled" default="false" />
  <xacro:arg name="ball_shooter_enabled" default="false" />
  <xacro:arg name="thruster_namespace" default="thrusters/"/>
  <xacro:arg name="camera_namespace" default="cameras/"/>
  <xacro:arg name="sensor_namespace" default="sensors/"/>
  <xacro:arg name="acoustic_namespace" default="acoustics/"/>
  <xacro:arg name="shooter_namespace" default="shooters/"/>
  <!-- Note: this is only used for some sensors that do not correctly use the
  robotNamespace parameter -->
  <xacro:arg name="namespace" default="wamv"/>
  <!-- Uniform linear scale factor applied to the whole platform (hull, thrusters,
       mass/inertia, hydrodynamics) -->
  <xacro:arg name="scale" default="1.0"/>
  <!-- Adds ArduPilotPlugin, driving the propeller joints directly (see
       thruster_config:=ArduPilot above, which must be used alongside this
       so nothing else fights it for the same joints). -->
  <xacro:arg name="ardupilot_enabled" default="false"/>
  <xacro:property name="thruster_namespace" value="$(arg thruster_namespace)" scope="global" />
  <xacro:property name="camera_namespace" value="$(arg camera_namespace)" scope="global" />
  <xacro:property name="sensor_namespace" value="$(arg sensor_namespace)" scope="global" />
  <xacro:property name="acoustic_namespace" value="$(arg acoustic_namespace)" scope="global" />
  <xacro:property name="shooter_namespace" value="$(arg shooter_namespace)" scope="global" />
  <xacro:property name="namespace" value="$(arg namespace)" scope="global" />
  <xacro:property name="scale" value="$(arg scale)" scope="global" />

  <!-- Sensor yaml file -->
  <xacro:arg name="yaml_component_generation" default="false"/>
  <xacro:arg name="component_xacro_file" default = ""/>

  <!-- Thruster yaml file -->
  <xacro:arg name="yaml_thruster_generation" default="false"/>
  <xacro:arg name="thruster_xacro_file" default = ""/>

  <!-- === The WAM-V platform === -->
  <xacro:arg name="macros_file" default="$(find wamv_gazebo)/urdf/macros.xacro"/>
  <xacro:include filename="$(find wamv_gazebo)/urdf/wamv_gazebo.xacro"/>

  <!-- === Batteries === -->
  <xacro:include filename="$(find wamv_description)/urdf/battery.xacro"/>
  <xacro:battery prefix="left" position="0 ${1*scale} ${0.45*scale}" orientation="0 0 0"/>
  <xacro:battery prefix="right" position="0 ${-1*scale} ${0.45*scale}" orientation="0 0 0"/>

  <!-- === Thrusters === -->
  <!-- Use thruster yaml file if given -->
  <xacro:if value="$(arg yaml_thruster_generation)">
    <xacro:wamv_gazebo thruster_layout="$(arg thruster_xacro_file)"/>
  </xacro:if>

  <!-- Otherwise, add thrusters based on thruster_config variable -->
  <xacro:unless value="$(arg yaml_thruster_generation)">
    <xacro:property name="thruster_conf" value="$(arg thruster_config)"/>

    <!-- Default WAM-V with two aft thrusters -->
    <xacro:if value="${thruster_conf == 'H'}">
       <xacro:wamv_gazebo thruster_layout="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_aft_thrusters.xacro"/>
    </xacro:if>

    <!-- WAMV with "T" thruster configuration -->
    <xacro:if value="${thruster_conf == 'T'}">
      <xacro:wamv_gazebo thruster_layout="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_t_thrusters.xacro"/>
    </xacro:if>

    <!-- WAMV with "X" thruster configuration -->
    <xacro:if value="${thruster_conf == 'X'}">
      <xacro:wamv_gazebo thruster_layout="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_x_thrusters.xacro"/>
    </xacro:if>

    <!-- Same aft-thruster physical layout as "H", but without the
         gz-sim-thruster-system plugin; see
         wamv_aft_thrusters_ardupilot.xacro for why (conflicts with
         ArduPilotPlugin driving the same joints, see ardupilot_enabled
         below). Use together with ardupilot_enabled:=true. -->
    <xacro:if value="${thruster_conf == 'ArduPilot'}">
      <xacro:wamv_gazebo thruster_layout="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_aft_thrusters_ardupilot.xacro"/>
    </xacro:if>
  </xacro:unless>

  <!-- === [Un]lock the robot to the world === -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>$(arg namespace)/base_link</parent_link>
      <child_model>platform</child_model>
      <child_link>dummy_upper</child_link>
      <topic>/vrx/release</topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </gazebo>

  <!-- === TF === -->
  <!-- Publish robot state information -->
  <gazebo>
    <plugin filename="libgz-sim-pose-publisher-system.so"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>false</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>


  <!-- === Sensors === -->
  <!-- Use sensor yaml file if given -->
  <xacro:if value="$(arg yaml_component_generation)">
    <xacro:include filename="$(arg component_xacro_file)"/>
    <xacro:yaml_components />

    <!-- Add CPU Cases -->
    <xacro:include filename="$(find wamv_description)/urdf/cpu_cases.xacro" />
    <xacro:cpu_cases position="-0.15 0 1.53" orientation="0 0 0"/>
  </xacro:if>

  <!-- Otherwise, add sensors based on enable variables -->
  <xacro:unless value="$(arg yaml_component_generation)">
    <!-- Add a front camera -->
    <xacro:if value="$(arg camera_enabled)">
      <xacro:wamv_camera name="front_camera" y="0.3" x="0.75" P="${radians(15)}" />
    </xacro:if>

    <!-- Add simulated GPS -->
    <xacro:if value="$(arg gps_enabled)">
      <xacro:wamv_gps name="gps_wamv" x="-0.85" />
    </xacro:if>

    <!-- Add Simulated IMU -->
    <xacro:if value="$(arg imu_enabled)">
      <xacro:wamv_imu name="imu_wamv" y="${-0.2*scale}" />
    </xacro:if>

    <!-- Add 3D LIDAR -->
    <xacro:if value="$(arg lidar_enabled)">
      <xacro:lidar name="lidar_wamv" y="-0.3" type="16_beam"/>
    </xacro:if>

    <!-- Add P3D ground truth -->
    <xacro:if value="$(arg ground_truth_enabled)">
      <xacro:wamv_p3d name="p3d_wamv"/>
    </xacro:if>

    <!-- Add pinger -->
    <xacro:if value="$(arg pinger_enabled)">
      <xacro:wamv_pinger sensor_name="receiver" position="-528 191 -2.0" />
    </xacro:if>

    <!-- Add ball shooter (default pitch angle: ~-60 deg) -->
    <xacro:if value="$(arg ball_shooter_enabled)">
      <xacro:wamv_ball_shooter name="ball_shooter" x="0.54" y="0.30" z="1.296" pitch="-1.04"/>
    </xacro:if>

    <!-- ==== VRX sensor configuration ==== -->
    <xacro:if value="$(arg vrx_sensors_enabled)">

      <!-- Add CPU Cases -->
      <xacro:include filename="$(find wamv_description)/urdf/cpu_cases.xacro" />
      <xacro:cpu_cases position="-0.15 0 1.53" orientation="0 0 0"/>

      <!-- Add a stereo camera pair -->
      <xacro:wamv_camera name="front_left_camera" y="0.1" x="0.75" P="${radians(15)}" />
      <xacro:wamv_camera name="front_right_camera" y="-0.1" x="0.75" P="${radians(15)}" />

      <!-- Add a camera facing right -->
      <xacro:wamv_camera name="middle_right_camera" y="-0.45" P="${radians(15)}" Y="${radians(-90)}" post_Y="${radians(-90)}" />

      <!-- Add simulated GPS -->
      <xacro:wamv_gps name="gps_wamv" x="-0.85" />

      <!-- Add Simulated IMU -->
      <xacro:wamv_imu name="imu_wamv" y="-0.2" />

      <!-- Add 3D LIDAR -->
      <xacro:lidar name="lidar_wamv" type="16_beam"/>

      <!-- Add pinger -->
      <xacro:wamv_pinger sensor_name="receiver" position="-528 191 -2.0" />

      <!-- Add ball shooter (default pitch angle: ~-60 deg) -->
      <xacro:wamv_ball_shooter name="ball_shooter" x="0.54" y="0.30" z="1.296" pitch="-1.04"/>

    </xacro:if>

  </xacro:unless>

  <!-- === ArduPilot SITL bridge (vrx_ardupilot package) === -->
  <!-- Requires imu_enabled:=true (for imu_wamv_link/imu_wamv_sensor below).
       Uses the normal thruster_config (H/gz-sim-thruster-system) rather
       than bypassing it: driving the propeller joint's own rotation
       directly (type=VELOCITY) produced no real thrust at all: Gazebo's
       physics doesn't translate a spinning joint into hull-pushing force by
       itself, that conversion is exactly what gz-sim-thruster-system does
       (thrust_coefficient etc.). So instead each <control> below uses
       type=COMMAND, which makes ArduPilotPlugin publish a plain Double onto
       a topic instead of actuating a joint, pointed at the same
       wamv/thrusters/{left,right}/thrust topic vrx_apf_dock's
       thrust_mixer_node normally publishes to, so ArduPilot drives VRX's
       existing, already-tuned thruster physics instead of reinventing it. -->
  <xacro:if value="$(arg ardupilot_enabled)">
    <gazebo>
      <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
        <!-- Correctif (voir en-tete de fichier) : terme de lacet GZ_PI/2
             manquant dans la valeur par defaut du plugin. -->
        <gazeboXYZToNED>0 0 0 3.141592653589793 0 1.5707963267948966</gazeboXYZToNED>
        <fdm_addr>127.0.0.1</fdm_addr>
        <!-- 9002 is ArduPilot's default SIM_OUT_PORT (SITL instance 0),
             used by the stock ardupilot_gazebo demo worlds (iris_runway
             etc.), which collide on this exact port if run alongside this
             WAM-V (confirmed via netstat: both processes bound to
             127.0.0.1:9002 simultaneously, silently stealing each other's
             packets). Use 9012 here, matching ArduPilot SITL instance 1
             (`-I 1`, which offsets SIM_IN_PORT/SIM_OUT_PORT by
             instance*10; see AP_HAL_SITL/SITL_cmdline.cpp). Launch SITL
             for this vehicle with `-I 1`. -->
        <fdm_port_in>9012</fdm_port_in>
        <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
        <lock_step>1</lock_step>
        <have_32_channels>0</have_32_channels>

        <!-- Unscoped on purpose: the scoped form (model::link::sensor) never
             resolved here (ArduPilotPlugin's own "Found IMU sensor" log line
             never appeared, silently retried forever), likely because the
             WAM-V's link name is literally "wamv/imu_wamv_link" (see the
             generated SDF), and gz-sim's scoped-name entity lookup appears to
             treat the embedded "/" as an extra nesting separator on top of
             "::", so the concatenated scoped string never matches. The
             plugin's own unscoped fallback (EntitiesFromUnscopedName, plain
             substring match, no "::"/"/" parsing) sidesteps this entirely. -->
        <imuName>imu_wamv_sensor</imuName>

        <!-- SERVO1 = ThrottleLeft (channel 0), SERVO3 = ThrottleRight
             (channel 2), matching ArduPilot Rover's skid-steer boat
             config (FRAME_CLASS=2 Boat, SERVO1_FUNCTION=73,
             SERVO3_FUNCTION=74, see ardupilot/Tools/autotest/
             default_params/rover-skid.parm). cmd = multiplier*(raw_cmd +
             offset), raw_cmd in [0,1] over [servo_min, servo_max]. offset
             -0.5 centers PWM 1500 (ArduPilot's throttle neutral) on 0 N,
             multiplier 1200 gives +-600 N full deflection (well under the
             thruster's own ~2353 N cap at this hull scale, matching the
             cruise-thrust range already used/tuned in vrx_apf_dock).
             Tried raising this to 3600 to fix an AUTO-mode zigzag, on the
             theory that the boat lacked real yaw torque authority. That was
             wrong: `gz topic -e` on the thrust topics showed the same
             sustained saturation at 3600 as at 1200 (command pinned at a
             constant value for 1.5-2s+ per half cycle) - the saturation is
             in ArduPilot's own normalized steering PID output (clipped
             near +-1 well before the multiplier is applied), not in
             available thrust. multiplier is not the right lever for this;
             reverted to 1200. -->
        <control channel="0">
          <jointName>${namespace}/left_engine_propeller_joint</jointName>
          <type>COMMAND</type>
          <cmd_topic>${namespace}/thrusters/left/thrust</cmd_topic>
          <multiplier>1200</multiplier>
          <offset>-0.5</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
        </control>
        <control channel="2">
          <jointName>${namespace}/right_engine_propeller_joint</jointName>
          <type>COMMAND</type>
          <cmd_topic>${namespace}/thrusters/right/thrust</cmd_topic>
          <multiplier>1200</multiplier>
          <offset>-0.5</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
        </control>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
