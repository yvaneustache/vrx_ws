<?xml version="1.0"?>
<package format="3">
  <name>vrx_ardupilot</name>
  <version>0.0.1</version>
  <description>Spawns a VRX WAM-V flown by ArduPilot Rover SITL (via ardupilot_gazebo's ArduPilotPlugin) instead of the vrx_apf_dock control stack, bridged to ROS 2 with MAVROS</description>

  <maintainer email="yvan.eustache@gmail.com">Yvan Eustache</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vrx_gz</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
