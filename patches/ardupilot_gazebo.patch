diff --git a/src/ArduPilotPlugin.cc b/src/ArduPilotPlugin.cc
index 8309c37..b811ca8 100755
--- a/src/ArduPilotPlugin.cc
+++ b/src/ArduPilotPlugin.cc
@@ -1106,8 +1106,14 @@ void gz::sim::systems::ArduPilotPlugin::PreUpdate(
     // it's not possible to get the fully qualified topic name we want
     if (!this->dataPtr->imuInitialized)
     {
-        // Set unconditionally because we're only going to try this once.
-        this->dataPtr->imuInitialized = true;
+        // Only set once the IMU entity is actually found and wired up
+        // below (not unconditionally here) -- for a model spawned
+        // dynamically at runtime (e.g. via the gz-sim "create" service,
+        // rather than statically included in the world file from t=0),
+        // the Sensors system may not have created the IMU sensor entity
+        // yet on this plugin's first PreUpdate() call. Retrying on
+        // subsequent ticks instead of giving up permanently after one
+        // miss lets it pick the sensor up as soon as it exists.
         std::string imuTopicName;
 
         // The model must contain an imu sensor element:
@@ -1178,12 +1184,15 @@ void gz::sim::systems::ArduPilotPlugin::PreUpdate(
         }
         else
         {
-            gzerr << "[" << this->dataPtr->modelName << "] "
-                  << "imu_sensor [" << this->dataPtr->imuName
-                  << "] not found, abort ArduPilot plugin." << "\n";
+            // Not found yet -- leave imuInitialized false and retry on
+            // the next PreUpdate() instead of aborting outright, in case
+            // the sensor entity simply hasn't been created yet (dynamic
+            // spawn race, see comment above).
             return;
         }
 
+        this->dataPtr->imuInitialized = true;
+
         this->dataPtr->node.Subscribe(imuTopicName,
             &gz::sim::systems::ArduPilotPluginPrivate::ImuCb,
             this->dataPtr.get());
