+<?xml version="1.0"?>
+<!-- Same physical engines/propellers as wamv_aft_thrusters.xacro, but WITHOUT
+     the gz-sim-thruster-system plugin (wamv_gazebo_thruster_config.xacro):
+     that plugin actively commands the propeller joint's velocity every step
+     (defaulting to 0 when nothing publishes to it), which would fight
+     ArduPilotPlugin's own direct joint control (see wamv_gazebo.urdf.xacro's
+     ardupilot_enabled block) for ownership of the same joint. Select via
+     thruster_config:=ArduPilot instead of the default H. -->
+<robot xmlns:xacro="http://ros.org/wiki/xacro">
+  <xacro:include filename="$(find wamv_description)/urdf/thrusters/engine.xacro" />
+  <xacro:engine prefix="left" position="${-2.373776*scale} ${1.027135*scale} ${0.318237*scale}" />
+  <xacro:engine prefix="right" position="${-2.373776*scale} ${-1.027135*scale} ${0.318237*scale}" />
+</robot>
